    "CreateViewSql": "select `m1`.`TANKA_SEQ` AS `TANKA_SEQ`,`m1`.`HINBAN` AS `HINBAN`,`m1`.`KIGYO_CODE` AS `KIGYO_CODE`,`m1`.`TORIHIKISAKI_CODE` AS `TORIHIKISAKI_CODE`,`t`.`TORIHIKISAKI_NAME` AS `TORIHIKISAKI_NAME`,`m1`.`TOROKU_TIMESTAMP` AS `TOROKU_TIMESTAMP`,`m1`.`TOROKUSHA_CODE` AS `TOROKUSHA_CODE`,`m1`.`KOSHIN_TIMESTAMP` AS `KOSHIN_TIMESTAMP`,`m1`.`KOSHINSHA_CODE` AS `KOSHINSHA_CODE` from (`mtanka` `m1` left join `mtorihiki` `t` on(((`m1`.`KIGYO_CODE` = `t`.`KIGYO_CODE`) and (`m1`.`TORIHIKISAKI_CODE` = `t`.`TORIHIKISAKI_CODE`)))) where (`m1`.`TANKA_SEQ` = (select min(`m2`.`TANKA_SEQ`) from `mtanka` `m2` where (`m2`.`HINBAN` = `m1`.`HINBAN`)))",
